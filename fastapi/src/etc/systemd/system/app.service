[Unit]
Description=FastAPI application (Uvicorn)
After=network.target

[Service]
User=app
Group=app
WorkingDirectory=/srv/app/src
EnvironmentFile=/etc/one-click/app.env
ExecStart=/srv/app/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=on-failure

[Install]
WantedBy=multi-user.target
