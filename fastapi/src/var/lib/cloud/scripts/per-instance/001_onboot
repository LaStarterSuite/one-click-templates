#!/bin/bash
# Inputs: GREETING
set -euo pipefail
. /usr/local/lib/one-click/lib.sh
# Central sends the inputs as user data; a VM launched without them falls back to defaults.
[ -f "$ONE_CLICK_INPUTS" ] && . "$ONE_CLICK_INPUTS"

# Made here, so each VM has its own key and it never leaves the VM.
save_credential SECRET_KEY "$(openssl rand -hex 32)"
save_credential GREETING "${GREETING:-}"
systemctl enable --now app
wait_for 60 curl -fsS http://127.0.0.1:8000/health

configure_nginx <<'NGINX'
server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;

	location / {
		proxy_pass http://127.0.0.1:8000;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		# The regional proxy ends TLS, so the visitor's scheme is the one it forwards.
		proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
	}
}
NGINX

mark_ready
