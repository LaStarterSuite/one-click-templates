#!/bin/bash
# Inputs: PROMETHEUS_PASSWORD, PUSH_PASSWORD, GRAFANA_PASSWORD, SITE_NAME, SITE_DOMAIN
set -euo pipefail
. /usr/local/lib/one-click/lib.sh
# Central sends the inputs as user data; a VM launched without them falls back to defaults.
[ -f "$ONE_CLICK_INPUTS" ] && . "$ONE_CLICK_INPUTS"

PROMETHEUS_USER=admin
PROMETHEUS_PASSWORD=${PROMETHEUS_PASSWORD:-$(openssl rand -hex 24)}
save_credential PROMETHEUS_USER "$PROMETHEUS_USER"
save_credential PROMETHEUS_PASSWORD "$PROMETHEUS_PASSWORD"

PUSH_USER=push
PUSH_PASSWORD=${PUSH_PASSWORD:-$(openssl rand -hex 24)}
save_credential PUSH_USER "$PUSH_USER"
save_credential PUSH_PASSWORD "$PUSH_PASSWORD"

# nginx asks for these logins; Prometheus itself listens only on localhost.
# nginx checks a login on every request, so it uses SHA-512 crypt, which is fast, not bcrypt.
# openssl reads the password from stdin, so it never shows in the process list.
write_login() {
	install -m 0640 -o root -g www-data /dev/null "$1"
	echo "$2:$(printf '%s' "$3" | openssl passwd -6 -stdin)" > "$1"
}
install -d -m 0755 /etc/nginx/one-click
write_login /etc/nginx/one-click/prometheus.htpasswd "$PROMETHEUS_USER" "$PROMETHEUS_PASSWORD"
write_login /etc/nginx/one-click/push.htpasswd "$PUSH_USER" "$PUSH_PASSWORD"
wait_for 60 systemctl is-active --quiet nginx
systemctl reload nginx

GRAFANA_USER=admin
GRAFANA_PASSWORD=${GRAFANA_PASSWORD:-$(openssl rand -hex 24)}
save_credential GRAFANA_USER "$GRAFANA_USER"
save_credential GRAFANA_PASSWORD "$GRAFANA_PASSWORD"

# Grafana sets the admin password only when it creates its database, so a database from the image is dropped.
systemctl stop grafana-server
rm -f /var/lib/grafana/grafana.db

install -d -m 0750 -o root -g grafana /etc/grafana/one-click
install -m 0640 -o root -g grafana /dev/null /etc/grafana/one-click/admin_password
printf '%s' "$GRAFANA_PASSWORD" > /etc/grafana/one-click/admin_password
install -m 0640 -o root -g grafana /dev/null /etc/grafana/one-click/secret_key
openssl rand -hex 32 | tr -d '\n' > /etc/grafana/one-click/secret_key

# Grafana builds the links in its alerts from its public address, and trusts logins from it behind the proxy.
if [ -n "${SITE_DOMAIN:-}" ]; then
	if ! [[ $SITE_DOMAIN =~ ^[a-z0-9.-]+$ ]]; then
		echo "SITE_DOMAIN must be a domain name." >&2
		exit 1
	fi
	save_credential SITE_DOMAIN "$SITE_DOMAIN"
	sed -i "s|__PUSH_URL__|https://$SITE_DOMAIN/prometheus/api/v1/write|" /var/www/one-click/connect.sh
	cat > /etc/grafana/one-click/grafana.env <<CONF
GF_SERVER_ROOT_URL=https://$SITE_DOMAIN/
GF_SECURITY_CSRF_TRUSTED_ORIGINS=$SITE_DOMAIN
CONF
fi

systemctl restart grafana-server

grafana_answers() {
	curl -fs -o /dev/null http://127.0.0.1:3000/api/health
}
wait_for 120 grafana_answers

mark_ready
